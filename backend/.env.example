DATABASE_URL="postgresql://minhadata:minhadata@localhost:5432/minhadata?schema=public"
# Em provedores com connection pooling (ex.: Neon), DIRECT_URL deve apontar
# para a conexão direta (sem pooler) — usada pelo Prisma só para migrations.
# Em desenvolvimento local (Docker), use o mesmo valor de DATABASE_URL.
DIRECT_URL="postgresql://minhadata:minhadata@localhost:5432/minhadata?schema=public"
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Gere valores aleatórios únicos por ambiente, ex.: openssl rand -hex 48
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-producao
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio-de-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Em produção (Render), defina NODE_ENV=production para que os cookies de
# sessão sejam marcados como Secure (exigem HTTPS).
NODE_ENV=development

# Upload de imagens dos espaços (conta gratuita em cloudinary.com).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Envio de e-mail transacional (conta gratuita em resend.com). Sem essa
# chave, o e-mail só é registrado no log do servidor (comportamento atual
# em desenvolvimento local).
RESEND_API_KEY=
# Remetente — sem domínio próprio verificado no Resend, use o domínio de
# testes deles (só entrega para o e-mail da sua própria conta Resend).
EMAIL_REMETENTE=MinhaData <onboarding@resend.dev>

# Notificação de status de reserva via WhatsApp (Meta WhatsApp Business
# Cloud API, developers.facebook.com). Sem essas variáveis, só loga no
# console. WHATSAPP_TEMPLATE_NAME precisa ser um template aprovado no
# WhatsApp Manager com o corpo: "Olá {{1}}! Sua reserva em {{2}} {{3}}.
# Data: {{4}}."
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=status_reserva
